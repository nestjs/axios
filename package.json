{
  "name": "@nestjs/axios",
  "version": "12.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "description": "Nest - modern, fast, powerful node.js web framework (@axios)",
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "url": "https://github.com/nestjs/axios#readme",
  "scripts": {
    "build": "rimraf -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"{lib,test}/**/*.ts\"",
    "lint": "oxlint lib/",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "prepublish:next": "npm run build",
    "publish:next": "npm publish --access public --tag next",
    "test:e2e": "vitest run --config ./vitest.config.mts",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-angular": "21.2.2",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.13.3",
    "axios": "1.20.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxlint": "^1.60.0",
    "prettier": "3.9.6",
    "reflect-metadata": "0.2.2",
    "release-it": "21.0.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "typescript": "^7.0.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "axios": "^1.3.1",
    "rxjs": "^7.0.0"
  },
  "lint-staged": {
    "**/*.{ts,json}": []
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nestjs/axios"
  }
}
